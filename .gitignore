# Safety net: never let raw PFF exports get committed by accident.
*.csv
*.xlsx

.DS_Store
.env
.idea/
.vscode/

node_modules/

.claude/

# playbook/ is private by default; the allow-list below publishes only what is meant to be public.
# Use `playbook/*` (not `playbook/`): git cannot re-include a path whose parent directory is excluded.
playbook/*
!playbook/ROSTER.md
!playbook/DECISIONS.md
!playbook/INVARIANTS.md
!playbook/architecture/
